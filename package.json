{
  "name": "falconai",
  "productName": "Falcon AI",
  "version": "1.0.0",
  "description": "Falcon — bilgisayarında tam yetkiyle çalışan, sesli Türkçe yapay zekâ ajanı (Electron + Gemini)",
  "author": {
    "name": "Umut Demirel",
    "email": "umutdemirel@users.noreply.github.com"
  },
  "license": "MIT",
  "main": "dist-electron/main.cjs",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build:electron && concurrently -k -n VITE,ELECTRON -c cyan,magenta \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "dev:electron": "electron .",
    "build:electron": "node scripts/build-electron.mjs",
    "build:renderer": "vite build",
    "build": "npm run build:electron && npm run build:renderer",
    "start": "npm run build && electron .",
    "typecheck": "tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "postinstall": "electron-builder install-app-deps",
    "test:backend": "npm run build:electron && node tests/run.cjs",
    "test:ui": "npm run build:renderer && node tests/ui-screenshot.mjs",
    "preview": "npm run build:renderer && vite preview --port 4173 --host 0.0.0.0"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/sora": "^5.3.0",
    "mammoth": "^1.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "lucide-react": "^1.61.0",
    "postcss": "^8.5.31",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.34.4",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "wait-on": "^9.5.1",
    "zustand": "^5.0.16"
  }
}
